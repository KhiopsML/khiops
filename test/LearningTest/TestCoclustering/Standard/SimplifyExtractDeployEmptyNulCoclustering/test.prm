// -> Khiops Coclustering
LearningTools.PostProcessCoclustering    // Simplify coclustering...

// -> Coclustering post-processing
SelectInputCoclustering        // Select input coclustering...

// -> Open
InputCoclusteringFileName ./AdultCoclusteringEmpty.khcj   // Input coclustering file
OK                             // Open
// <- Open

PostProcessingSpec.MaxCellNumber 1     // Max cell number
PostProcessedCoclusteringFileName ./results/PostProcessedCoclusteringEmpty.khcj         // Simplified coclustering report
PostProcessCoclustering        // Simplify coclustering

// -> Coclustering post-processing
SelectInputCoclustering        // Select input coclustering...

// -> Open
InputCoclusteringFileName ./AdultCoclusteringEducationOccupationNul.khcj   // Input coclustering file
OK                             // Open
// <- Open

PostProcessingSpec.MaxCellNumber 1     // Max cell number
PostProcessedCoclusteringFileName ./results/PostProcessedCoclusteringNul.khcj         // Simplified coclustering report
PostProcessCoclustering        // Simplify coclustering

Exit                           // Close
// <- Coclustering post-processing


LearningTools.ExtractClusters  // Extract clusters...

CoclusteringAttribute education         // Coclustering variable
ClusterFileName ./results/ClustersEducationNul.txt     // Cluster table file
ExtractClusters                // Extract clusters

// -> Coclustering post-processing
SelectInputCoclustering        // Select input coclustering...

// -> Open
InputCoclusteringFileName ./AdultCoclusteringEmpty.khcj   // Input coclustering file
OK                             // Open
// <- Open

CoclusteringAttribute sex         // Coclustering variable
ClusterFileName ./results/ClustersSexEmpty.txt     // Cluster table file
ExtractClusters                // Extract clusters

Exit                           // Close
// <- Cluster extraction

// -> Khiops Coclustering
ClassManagement.OpenFile       // Open...

// -> Open
ClassFileName ./AdultMT.kdic    // Dictionary file
OK                             // Open
// <- Open

LearningTools.PrepareDeployment          // Prepare deployment...

DeploymentSpec.InputClassName Occupation // Input dictionary
DeploymentSpec.InputObjectArrayAttributeName Samples          // Input array variable
DeploymentSpec.DeployedAttributeName occupation    // Coclustering deployed variable
DeploymentSpec.BuildPredictedClusterAttribute true // Build predicted cluster variable
DeploymentSpec.BuildClusterDistanceAttributes true // Build inter-cluster distance variables
DeploymentSpec.BuildFrequencyRecodingAttributes true         // Build frequency recoding variables
DeploymentSpec.OutputAttributesPrefix P_ // Output variables prefix
CoclusteringDictionaryFileName ./results/DeployOccupationEmpty.kdic   // Coclustering dictionary file

PrepareDeployment              // Prepare deployment

// -> Coclustering deployment preparation
SelectInputCoclustering        // Select input coclustering...

