{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "ignorePaths": [
    "packaging/dockerfiles/**"
  ],
  "pre-commit": {
    "enabled": true
  },
  "rebaseWhen": "never",
  "timezone": "Europe/Paris",
  "schedule": [
    "* * * * 0"
  ]
}
