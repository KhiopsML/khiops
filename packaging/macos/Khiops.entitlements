<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- MPI executables load the Open MPI libraries installed by Homebrew, which are
         not signed with the Khiops Team ID. Without this entitlement, the hardened
         runtime library validation rejects them at launch. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- The launcher uses DYLD_LIBRARY_PATH to locate the bundled JVM. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <!-- Required by the embedded JVM under the hardened runtime -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
